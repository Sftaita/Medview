{# ------------------------------------------------------------------
   MedVue — export PDF des absences d'un planning (docs/availability.md §11,
   docs/decisions.md D181).
   Contexte : PlanningAbsenceExportPdfRenderer::view() — title, periodLabel,
   generatedAtLabel, months[{label, dense, legend[{name, color, tint,
   daysLabel}], weeks[[7 × {number, monthTag, inRange, weekend, absent[{name, color,
   tint}]}]]}], members[{name, color, tint, lines, periods[], totalLabel,
   membershipLabel}].
   Rendu par dompdf (A4 paysage) : CSS 2.1 simple, police DejaVu Sans.
   Un mois commence toujours une page ; chaque semaine est une table à part
   (dompdf ignore page-break-inside sur un <tbody>) jamais coupée et qui
   rappelle son mois. Une case grandit avec le nombre d'absents : aucun nom
   n'est jamais tronqué. Le récapitulatif commence une page, son en-tête de
   table est répété sur chaque page de suite. « Page n / N » est posé par
   le renderer.
   ------------------------------------------------------------------ #}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>{{ documentTitle }}</title>
<style>
  @page { margin: 10mm 10mm 14mm 10mm; }
  body { font-family: 'DejaVu Sans', sans-serif; font-size: 7.5pt; color: #16202B; }
  .footer { position: fixed; bottom: -9mm; left: 0; right: 0; height: 6mm; font-size: 6.5pt; color: #727E8C; }
  .footer .left { position: absolute; left: 0; top: 0; }
  .footer .right { position: absolute; right: 0; top: 0; }
  .page { page-break-before: always; }
  .page.first { page-break-before: auto; }
  .head { margin: 0 0 4pt 0; }
  .head .doc { font-size: 8pt; color: #52606D; }
  .head .doc strong { color: #2C7D5F; }
  h2 { font-size: 14pt; margin: 1pt 0 0 0; color: #16202B; }
  .legend { margin: 3pt 0 2pt 0; line-height: 1.6; }
  .legend .chip { white-space: nowrap; padding: 0.5pt 3pt; margin-right: 4pt; }
  .legend .count { color: #52606D; }
  .legend .none { color: #727E8C; }
  .week { page-break-inside: avoid; margin-top: 4pt; }
  table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  tr.days td { background: #EEF3F6; color: #3A4754; font-weight: bold; padding: 1.5pt 4pt; text-align: left; white-space: nowrap; }
  tr.days td.we { background: #E2EBE6; }
  tr.days td.out { background: #F6F7F9; color: #C3C9D0; }
  tr.days .wd { font-weight: normal; color: #52606D; }
  tr.days td.out .wd { color: #C3C9D0; }
  tr.names td { height: 26pt; padding: 1.5pt 2pt; border-bottom: 0.5pt solid #E1E6EB; border-left: 0.5pt solid #E1E6EB; vertical-align: top; word-wrap: break-word; line-height: 1.2; }
  tr.names td.first { border-left: none; }
  tr.names td.we { background: #FAFBFC; }
  tr.names td.out { background: #F1F3F5; }
  .who { display: block; margin-bottom: 1pt; padding: 0.5pt 2pt; border-left: 2.5pt solid #2C7D5F; }
  .dense .who { font-size: 6.5pt; margin-bottom: 0.5pt; }
  .chip { border-left: 2.5pt solid #2C7D5F; }
  .summary { margin-top: 2pt; }
  .summary thead td { background: #EEF3F6; color: #3A4754; font-weight: bold; padding: 3pt 4pt; border-bottom: 0.5pt solid #C9D2DA; }
  .summary tr { page-break-inside: avoid; }
  .summary tbody td { padding: 3pt 4pt; border-bottom: 0.5pt solid #E1E6EB; vertical-align: top; word-wrap: break-word; line-height: 1.3; }
  .summary .c-name { width: 24%; }
  .summary .c-line { width: 18%; }
  .summary .c-total { width: 10%; text-align: right; white-space: nowrap; }
  .summary .member { padding-left: 3pt; font-weight: bold; }
  .summary .note { display: block; font-size: 6.5pt; color: #727E8C; font-weight: normal; }
  .summary .empty { color: #727E8C; }
  .summary .zero { color: #727E8C; }
</style>
</head>
<body>
  <div class="footer">
    <span class="left">Absences · {{ title }} · {{ periodLabel }}</span>
    <span class="right">Document généré le {{ generatedAtLabel }} — absences déclarées à cette date</span>
  </div>

  {% for month in months %}
    <div class="page{{ loop.first ? ' first' : '' }}{{ month.dense ? ' dense' : '' }}">
      <div class="head">
        <div class="doc"><strong>Absences · {{ title }}</strong> · {{ periodLabel }}</div>
        <h2>{{ month.label }}</h2>
        <div class="legend">
          {%- for entry in month.legend -%}
            <span class="chip" style="border-left-color: {{ entry.color }}; background: {{ entry.tint }};">{{ entry.name }} <span class="count">({{ entry.daysLabel }})</span></span>{{ ' ' }}
          {%- else -%}
            <span class="none">Aucune absence déclarée ce mois-ci.</span>
          {%- endfor -%}
        </div>
      </div>

      {% for week in month.weeks %}
        <div class="week">
          <table>
            <tr class="days">
              {% for day in week %}<td class="{{ day.weekend ? 'we' : '' }}{{ day.inRange ? '' : ' out' }}"><span class="wd">{{ ['lun.', 'mar.', 'mer.', 'jeu.', 'ven.', 'sam.', 'dim.'][loop.index0] }}</span> {{ day.number }}{% if day.monthTag %} {{ day.monthTag }}{% endif %}</td>{% endfor %}
            </tr>
            <tr class="names">
              {% for day in week %}
                <td class="{{ loop.first ? 'first ' : '' }}{{ day.weekend ? 'we' : '' }}{{ day.inRange ? '' : ' out' }}">
                  {%- for person in day.absent -%}
                    <span class="who" style="border-left-color: {{ person.color }}; background: {{ person.tint }};">{{ person.name }}</span>
                  {%- endfor -%}
                </td>
              {% endfor %}
            </tr>
          </table>
        </div>
      {% endfor %}
    </div>
  {% endfor %}

  <div class="page">
    <div class="head">
      <div class="doc"><strong>Absences · {{ title }}</strong> · {{ periodLabel }}</div>
      <h2>Récapitulatif des absences par membre</h2>
    </div>
    <table class="summary">
      <thead>
        <tr>
          <td class="c-name">Nom et prénom</td>
          <td class="c-line">Équipe / Ligne</td>
          <td>Périodes d’absence</td>
          <td class="c-total">Total</td>
        </tr>
      </thead>
      <tbody>
        {% for member in members %}
          <tr>
            <td class="c-name"><div class="member chip" style="border-left-color: {{ member.color }};">{{ member.name }}{% if member.membershipLabel %}<span class="note">{{ member.membershipLabel }}</span>{% endif %}</div></td>
            <td class="c-line">{{ member.lines }}</td>
            <td>{% if member.periods is empty %}<span class="empty">Aucune absence déclarée</span>{% else %}{{ member.periods|join(', ') }}{% endif %}</td>
            <td class="c-total{{ member.periods is empty ? ' zero' : '' }}">{{ member.totalLabel }}</td>
          </tr>
        {% else %}
          <tr><td colspan="4" class="empty">Aucun participant sur la période du planning.</td></tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="summary-note" style="color: #727E8C; font-size: 6.5pt; margin-top: 6pt;">
      Total : nombre de journées calendaires de la période du planning comportant au moins une indisponibilité déclarée (une journée partiellement indisponible compte pour une journée). Ce n’est pas un solde de congés.
    </p>
  </div>
</body>
</html>
