{# ------------------------------------------------------------------
   MedVue — 1. Ajouté à une équipe (le destinataire a déjà un compte)
   Objet : Vous avez été ajouté à une équipe sur MedVue
   Contexte : firstName, inviterName, teamName, planningName, planningUrl
   Repris de docs/Design/emails_medvue ; modifications : les noms
   saisis par un tiers passent par |e avant d'entrer dans ui.p() (qui
   rend son argument tel quel), et l'email nomme le planning et mène
   directement à lui (D221) au lieu de la page de connexion.
   ------------------------------------------------------------------ #}
{% extends 'email/_base.html.twig' %}
{% import  'email/_components.html.twig' as ui %}

{% set preheader  = 'Vous faites désormais partie du planning ' ~ planningName ~ ' sur MedVue.' %}
{% set accent     = '#42A882' %}
{% set eyebrow    = 'Équipe' %}
{% set h1         = 'Vous avez rejoint<br>une nouvelle équipe' %}
{% set panelLabel = 'Planning' %}
{% set panelTitle = planningName %}
{% set panelSub   = 'Équipe ' ~ teamName ~ ' · ajouté par ' ~ inviterName %}
{% set ctaLabel   = 'Ouvrir le planning' %}
{% set ctaUrl     = planningUrl %}
{% set footerNote = 'Vous recevez cet email car votre compte MedVue a été ajouté à une équipe.' %}

{% block title %}Vous avez rejoint une équipe{% endblock %}
{# Pas d'adresse postale : celle de la maquette est un exemple ; à renseigner ici une fois l'adresse légale confirmée. #}
{% block postal %}{% endblock %}

{% block content %}
{{ ui.p('Bonjour ' ~ firstName|e ~ ',', 24) }}
{{ ui.p(ui.b(inviterName) ~ ' vous a ajouté à l’équipe ' ~ ui.b(teamName) ~ ' du planning ' ~ ui.b(planningName) ~ ' sur MedVue.', 18) }}
{{ ui.p('Ce planning est désormais accessible directement depuis votre compte MedVue.') }}
{{ ui.p('Le bouton ci-dessous vous y mène ; MedVue vous demandera de vous connecter si nécessaire.') }}
{% endblock %}
