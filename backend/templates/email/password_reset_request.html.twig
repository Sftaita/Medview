{# ------------------------------------------------------------------
   MedVue — Réinitialisation du mot de passe (lien de reset)
   Objet : Réinitialisation de votre mot de passe MedVue
   Contexte : firstName, resetUrl, ttlMinutes
   resetUrl : lien à usage unique, token dans le fragment (#token=...),
   jamais envoyé au serveur (voir PasswordResetMailer).
   ------------------------------------------------------------------ #}
{% extends 'email/_base.html.twig' %}
{% import  'email/_components.html.twig' as ui %}

{% set preheader  = 'Un lien pour choisir un nouveau mot de passe, valable ' ~ ttlMinutes ~ ' minutes.' %}
{% set accent     = '#2D7FF9' %}
{% set eyebrow    = 'Mot de passe oublié' %}
{% set h1         = 'Réinitialisez<br>votre mot de passe' %}
{% set panel      = false %}
{% set ctaLabel   = 'Choisir un nouveau mot de passe' %}
{% set ctaUrl     = resetUrl %}
{% set footerNote = 'Vous recevez cet email car une réinitialisation de mot de passe a été demandée pour ce compte MedVue.' %}

{% block title %}Réinitialisation de votre mot de passe{% endblock %}
{% block postal %}{% endblock %}

{% block content %}
{{ ui.p('Bonjour ' ~ firstName|e ~ ',', 24) }}
{{ ui.p('Une demande de réinitialisation de mot de passe a été faite pour votre compte MedVue. Cliquez sur le bouton ci-dessous pour choisir un nouveau mot de passe :') }}
{% endblock %}

{% block after_cta %}
{{ ui.warning('Ce lien expire dans ' ~ ttlMinutes ~ ' minutes.', 'Passé ce délai, vous devrez faire une nouvelle demande depuis la page de connexion.') }}
{{ ui.p('Si vous n’êtes pas à l’origine de cette demande, vous pouvez ignorer cet email en toute sécurité : votre mot de passe ne sera pas modifié.', 16) }}
{% endblock %}
