{# ------------------------------------------------------------------
   MedVue — Rappel programmé d'une période (préparation, D210)
   Objet : La génération des gardes approche — <planning>
   Envoyé à tous les participants de la période (D214 : plus aucune confirmation).
   Contexte : firstName, planningName, periodNumber, periodLabel, targetLabel (ou null), deadlineLabel (ou null), availabilityUrl
   ------------------------------------------------------------------ #}
{% extends 'email/_base.html.twig' %}
{% import  'email/_components.html.twig' as ui %}

{% set preheader  = 'La génération des gardes de ' ~ planningName ~ ' approche.' %}
{% set accent     = '#42A882' %}
{% set eyebrow    = 'Rappel' %}
{% set h1         = 'La génération<br>des gardes approche' %}
{% set panelLabel = 'Planning' %}
{% set panelTitle = planningName %}
{% set panelSub   = 'Période ' ~ periodNumber ~ ' · du ' ~ periodLabel %}
{% set ctaLabel   = 'Vérifier mon calendrier' %}
{% set ctaUrl     = availabilityUrl %}
{% set footerNote = 'Vous recevez cet email car vous participez à un planning de garde sur MedVue.' %}

{% block title %}Rappel de disponibilités{% endblock %}
{% block postal %}{% endblock %}

{% block content %}
{{ ui.p('Bonjour ' ~ firstName|e ~ ',', 24) }}
{{ ui.p('La génération des gardes du planning ' ~ ui.b(planningName) ~ ' (période du ' ~ periodLabel|e ~ ') approche.', 18) }}
{{ ui.p('Pensez à vérifier et à actualiser vos éventuelles indisponibilités avant la date prévue de génération. Sans indisponibilité renseignée, vous êtes considéré comme disponible.') }}
{% if deadlineLabel %}
{{ ui.p('Date limite indicative : ' ~ deadlineLabel|e ~ '. Votre calendrier reste modifiable après cette date.') }}
{% endif %}
{% if targetLabel %}
{{ ui.p('Génération prévue aux alentours du ' ~ targetLabel|e ~ '. Les indisponibilités prises en compte seront celles présentes dans MedVue à ce moment-là.') }}
{% endif %}
{% endblock %}
