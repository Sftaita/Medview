{# ------------------------------------------------------------------
   MedVue — Rappel programmé d'une période (préparation, D210)
   Objet : Rappel : merci de confirmer vos disponibilités — <planning>
   Envoyé seulement aux personnes qui n'ont pas encore confirmé.
   Contexte : firstName, planningName, periodNumber, periodLabel, targetLabel (ou null), availabilityUrl
   ------------------------------------------------------------------ #}
{% extends 'email/_base.html.twig' %}
{% import  'email/_components.html.twig' as ui %}

{% set preheader  = 'Vos disponibilités pour ' ~ planningName ~ ' ne sont pas encore confirmées.' %}
{% set accent     = '#42A882' %}
{% set eyebrow    = 'Rappel' %}
{% set h1         = 'Vos disponibilités<br>sont attendues' %}
{% set panelLabel = 'Planning' %}
{% set panelTitle = planningName %}
{% set panelSub   = 'Période ' ~ periodNumber ~ ' · du ' ~ periodLabel %}
{% set ctaLabel   = 'Confirmer mes disponibilités' %}
{% set ctaUrl     = availabilityUrl %}
{% set footerNote = 'Vous recevez cet email car vous participez à un planning de garde sur MedVue et n’avez pas encore confirmé vos disponibilités.' %}

{% block title %}Rappel de disponibilités{% endblock %}
{% block postal %}{% endblock %}

{% block content %}
{{ ui.p('Bonjour ' ~ firstName|e ~ ',', 24) }}
{{ ui.p('Vous n’avez pas encore confirmé vos disponibilités pour le planning de garde ' ~ ui.b(planningName) ~ ' (période du ' ~ periodLabel|e ~ ').', 18) }}
{{ ui.p('Merci de vérifier vos indisponibilités dans MedVue et de confirmer qu’elles sont à jour — y compris si vous n’en avez aucune.') }}
{% if targetLabel %}
{{ ui.p('La génération du planning est prévue aux alentours du ' ~ targetLabel|e ~ '.') }}
{% endif %}
{% endblock %}
