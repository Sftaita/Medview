{# ------------------------------------------------------------------
   MedVue — Republication : les changements de VOS gardes (docs/decisions.md D172)
   Objet : Modification de vos gardes — <planning>
   Contexte : firstName, planningName, planningUrl, unitCount,
     removed[{line, detail, when, dates}] / added[{line, detail, when, dates}] —
     un bloc une seule fois, avec sa plage ET chacune de ses dates.
   Envoyé uniquement aux personnes dont les propres gardes ont changé,
   avec leurs seuls changements. PDF du planning actualisé joint.
   ------------------------------------------------------------------ #}
{% extends 'email/_base.html.twig' %}
{% import  'email/_components.html.twig' as ui %}

{% set preheader  = 'Vos gardes du planning ' ~ planningName ~ ' ont été modifiées.' %}
{% set accent     = '#2D7FF9' %}
{% set eyebrow    = 'Modification' %}
{% set h1         = 'Vos gardes<br>ont été modifiées' %}
{% set panelLabel = 'Planning' %}
{% set panelTitle = planningName %}
{% set panelSub   = unitCount > 1 ? unitCount ~ ' changements vous concernent' : '1 changement vous concerne' %}
{% set ctaLabel   = 'Voir le planning actualisé' %}
{% set ctaUrl     = planningUrl %}
{% set footerNote = 'Vous recevez cet email car une de vos gardes de ce planning a été ajoutée ou retirée.' %}

{% block title %}Modification de vos gardes{% endblock %}
{% block postal %}{% endblock %}

{% block content %}
{{ ui.p('Bonjour ' ~ firstName|e ~ ',', 24) }}
{{ ui.p('Vos gardes du planning ' ~ ui.b(planningName) ~ ' ont été modifiées. Voici ce qui change pour vous.', 18) }}
{% for section in [
    {units: removed, title: removed|length > 1 ? 'Gardes retirées' : 'Garde retirée'},
    {units: added, title: added|length > 1 ? 'Gardes ajoutées' : 'Garde ajoutée'},
] %}
{% if section.units is not empty %}
{{ ui.divider() }}
{{ ui.p(ui.b(section.title), 18) }}
{% for u in section.units %}
{{ ui.p(ui.b(u.when) ~ '<br>' ~ u.line|e ~ (u.detail ? ' — ' ~ u.detail|e : '') ~ (u.dates is not empty ? '<br>' ~ u.dates|map(d => d|e)|join('<br>') : ''), 14) }}
{% endfor %}
{% endif %}
{% endfor %}
{{ ui.divider() }}
{{ ui.p('Le planning complet actualisé est joint en PDF. Il reste consultable à tout moment dans MedVue.', 22) }}
{% endblock %}
