{# ------------------------------------------------------------------
   MedVue — Alerte de sécurité : mot de passe modifié
   Objet : Votre mot de passe MedVue a été modifié
   Contexte : firstName, loginUrl
   Pas de token dans cet email : envoyé après coup, jamais combiné avec
   le lien de réinitialisation (email password_reset_request).
   ------------------------------------------------------------------ #}
{% extends 'email/_base.html.twig' %}
{% import  'email/_components.html.twig' as ui %}

{% set preheader  = 'Votre mot de passe MedVue vient d’être modifié.' %}
{% set accent     = '#2D7FF9' %}
{% set eyebrow    = 'Sécurité du compte' %}
{% set h1         = 'Votre mot de passe<br>a été modifié' %}
{% set panel      = false %}
{% set ctaLabel   = 'Me connecter' %}
{% set ctaUrl     = loginUrl %}
{% set footerNote = 'Vous recevez cet email suite à une modification du mot de passe de votre compte MedVue.' %}

{% block title %}Votre mot de passe a été modifié{% endblock %}
{% block postal %}{% endblock %}

{% block content %}
{{ ui.p('Bonjour ' ~ firstName|e ~ ',', 24) }}
{{ ui.p('Le mot de passe de votre compte MedVue vient d’être modifié. Toutes vos sessions actives ont été déconnectées ; vous devrez vous reconnecter avec votre nouveau mot de passe.') }}
{% endblock %}

{% block after_cta %}
{{ ui.warning('Ce n’était pas vous ?', 'Si vous n’êtes pas à l’origine de ce changement, contactez sans attendre l’administrateur ou le support MedVue à l’adresse ci-dessous.') }}
{% endblock %}
