# Fichier réel de production — copier en `.env` sur le serveur uniquement
# (/opt/stack/apps/medvue/.env), chmod 600, NE JAMAIS committer.
# Toutes les valeurs <CHANGE_ME> doivent être générées pour la prod,
# jamais réutilisées depuis backend/.env (dev).

# --- Postgres ---
POSTGRES_DB=medvue
POSTGRES_USER=medvue
POSTGRES_PASSWORD=<CHANGE_ME>

# --- Symfony ---
APP_ENV=prod
APP_SECRET=<CHANGE_ME>
APP_SHARE_DIR=var/share
DEFAULT_URI=https://api.medvue.be

# --- Doctrine ---
DATABASE_URL="postgresql://medvue:<CHANGE_ME_SAME_AS_POSTGRES_PASSWORD>@database:5432/medvue?serverVersion=16&charset=utf8"

# --- lexik/jwt-authentication-bundle ---
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=<CHANGE_ME>
JWT_TOKEN_TTL=900

# --- app/refresh-tokens ---
REFRESH_TOKEN_TTL=2592000
# MUST be true: the app is served over HTTPS in prod (never false here).
COOKIE_SECURE=true

# --- nelmio/cors-bundle ---
CORS_ALLOW_ORIGIN='^https://(www\.)?medvue\.be$'

# --- Frontend build (baked at image build time, see frontend/Dockerfile.prod) ---
VITE_API_URL=https://api.medvue.be
